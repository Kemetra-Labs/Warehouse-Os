{
  "name": "warehouse-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/almarai": "5.3.0",
    "barcode-detector": "3.2.2",
    "exceljs": "4.4.0",
    "firebase": "13.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "firebase-tools": "15.33.0",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixture": "node scripts/make-fixture.mjs",
    "test:unit": "vitest run",
    "test:rules": "node scripts/render-rules.mjs --test-uid && firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test",
    "test:parity": "vitest run tests/parity",
    "emulators": "node scripts/render-rules.mjs --test-uid && firebase emulators:start --only auth,firestore,ui",
    "deploy": "node scripts/render-rules.mjs && npm run build && firebase deploy --only hosting,firestore:rules"
  }
}

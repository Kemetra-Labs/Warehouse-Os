# Copy to .env.local (never commit it). Firebase web config is not secret, but keep per-environment.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# 1 = talk to the local Auth/Firestore emulators
VITE_USE_EMULATORS=1
# Firebase Auth UID of the single owner; substituted into firestore.rules at deploy time
OWNER_UID=
